# R2 serving configuration, 4x GH200 (96 GB), aarch64 (the Clariden configuration of the R2 release).
# Read by scripts/serve_fpr.sh and scripts/prebuild_fpr.sh: FPR_CONFIG=fpr/config/r2_gh200.env
# The native C/C++ loop on top of it: fpr/config/native_r2.env
export PHYS_GEOM=window_pool_bytes=600000000,max_prefill_tokens_per_rank=1344,state_pool_slots=160 FPR_WORKER_GEOM=1
FPR_ENGINE="indexer=idx2f,engram=phys,head=hsd,hsd_fold=1,hsd_mhc2=1,mixed_bucket_bytes=2400000000,hsd_moe=v4,buckets=4:8:32:64:112:120:128:192:224,max_mixed_rows=1600"
FPR_FLAGS="ENG_LONG_GRAPHS=1 IDX2F_CANON_STOCK=1 PHYS_COST=eager_ctx_above=655360 ENG_AGRS_RSF=1 ENG_AGRS_SUM528=1 ENG_AGRS_AGCE=1 ENG_QB16_MIXED=0 ENG_ATTN_PF=1 ENG_MHCF=1 ENG_QB16_DECODE=0 IDX2F_PF=1 ENG_IDX_FUSE=1 ENG_IDX_SIDE=1 ENG_IDX_F8=1 ENG_G6=1 ENG_AGRS_RSD=1 ENG_LAUNCH_SPLIT=1 ENG_C1_COMM=1 ENG_C1_AGW=1 ENG_C1_PDL=1 ENG_C1_QB_OVERLAP=1 W8A16_DEFS=W8_NTMIN=32 ENG_C1_TPWO=0 ENG_C1_ATTN_HG=1 ENG_C1_ATTN_HG_MAXR=4 ENG_C1_AGRT=1 HSD_TPWO=1 ENG_C1_RSC=1 ENG_C1_RSL=1 HSD_R2R=1 ENG_HSDT=mhcf,par,dmask,xg,c1d,ctxtp,dhead,ctx3 ENG_HSDT_MOD=hsdt_c1e HSDT_C1D_SMAX=4 ENG_C1_MEGA=1 C1M_PKG=kernels/c1mega/srv8x C1M_SRC=c1mega_srv.cu C1M_B16=wqkv,woa8,wob8,sh,qb8 C1M_BUILD=build_srv C1M_IX=1 C1IDX_E0=1 C1M_CUT=none ENG_D13_GT=1 ENG_D13_ERR_EVERY=64 ENG_D13_EMPTY=1 ENG_D13_ADV_SLICE=1 ENG_D13_RES_OWNER=1 ENG_D13_OWNER=1 ENG_D13S=on ENG_MIX_TBL_CAP=1 ENG_MAX_TAIL_ROWS=1536 FPR_PAGECOPY=1 ENG_PF_WS_PREALLOC_MB=1536 ENG_AGRS_WS=2 ENG_MIXED_CXX_PIECES=bd,router,ag,rs,final,moe ENG_MIXED_CXX_RUN=1 ENG_MIXED_PRESTEP=1 ENG_MIXED_CXX_HEAD=1 ENG_D13_TFUSE=1 FPR_ENGRAM_STAGE=8 ENG_WO_W8A16=1 ENG_MIX_ONE_BUCKET=1 ENG_MIXED_CXX_AUX_SHARED=1 ENG_MIX_ONE_BUCKET_T=1 ENG_WO_W8A16_DQ=1 ENG_QB_DQ=1 W8DQ_IMPL=2 IDX2F_TOPK4=256 ENG_MOE_CXX_FUSED=1 ENG_WO_ONECOPY=1"
FPR_MAX_SEQS=224
FPR_SCHED="mixed_target_tokens=12288,mixed_target_fill=1,mixed_target_wait_s=1.0,cp_min=2048,backlog_drain_wait_s=20.0,mixed_target_full_wait_s=0,cp_force_min=16384,cp_force_decode_steps=0,cp_force_room_frac=1.0,cp_force_order=tiered,cp_force_srpt_min_left=131072"
FPR_CP=1
FPR_ASYNC=0
