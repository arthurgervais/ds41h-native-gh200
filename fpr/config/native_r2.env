# R2-A native C/C++ serving loop: the environment the R2-A release (Clariden, frozen) serves with, on top of fpr/config/r2_gh200.env (4x GH200).
# Source it after the serving configuration, then start scripts/serve_fpr.sh:
#
#   export FPR_CONFIG=$DS41H_REPO/fpr/config/r2_gh200.env
#   source $DS41H_REPO/fpr/config/native_r2.env
#   bash $DS41H_REPO/scripts/serve_fpr.sh
#
# Paths are placeholders. Point them at your builds of this repository's native modules (README.md, "Build"):
#   FPR_NATIVE_BUILD   fpr_core_py / fpr_sched_py / fpr_kvtables (built from fpr/core)
#   FPR_CORE2B_DIR     fpr_core2b (built from packages/core2b with packages/core2b/tests/core.mk, target core2b)
#   FPR_ND_DIR         packages/nd (the native decode module; JIT-built by nd_cxx.py on first use, or prebuilt)
DS41H_REPO=${DS41H_REPO:?set DS41H_REPO to this repository}
FPR_NATIVE_BUILD=${FPR_NATIVE_BUILD:-$DS41H_HOME/build/fpr_core}
FPR_CORE2B_DIR=${FPR_CORE2B_DIR:-$DS41H_HOME/build/core2b}
FPR_ND_DIR=${FPR_ND_DIR:-$DS41H_REPO/packages/nd}
SEATS=${SEATS:-64}          # concurrent sequences (Clariden R2 gate: 64; raise with HBM headroom)
HBM_PAGES=${HBM_PAGES:-8192}  # (R2-A gate: 8192 HBM pages with 64 seats)

# serving base (engine, memory, host placement)
export ENGINE=fpr FPR_SEATS=$SEATS ASYNC=1 FPR_KV_HOST_GB=20 FPR_KV_HBM_PAGES=$HBM_PAGES FPR_HSD_CAP_BUCKETS=1 \
  FPR_HOSTMAP=emb,emb_share,gate,engram,vision,rope FPR_SIZE_EMPTY_CACHE=1 FPR_RESERVE_GB=0 ENG_FREE_CACHE_GB=4 \
  ENG_FAST_EACH=1 FPR_LONG_ANY_ROWS=1 FPR_HOST_NUMA=bind FPR_ENGRAM_NUMA=interleave FPR_STEP_LOG=10 MAXLEN=655360 FPR_CRUMBS=0

# native mixed step (C++ pieces), precapture and the long-context path
export ENG_MIXED_CXX_IDXA=1 ENG_MIXED_CXX_PIECES=embed,engram,bd,router,ag,rs,final,moe,attn_a,idx,attn_b,attn_pf \
  ENG_MIXED_CXX_IDXA_STOCK=1 ENG_HEAD_BM_GRAPH=1 ENG_CXX_EMBED_STAGE=1 ENG_DECODE_PRECREATE=1 ENG_MIX_PRECREATE=1 \
  ENG_MIX_PERSIST=1 ENG_TAIL_GATHER=1 ENG_TAIL_GATHER_KERNEL=1 ENG_MIX_ENSURE=1 ENG_CXX_TB=1 \
  ENG_NATIVE_BOUNDARY=1 ENG_PRECAP_DEFER=1 ENG_PRECAP_EST_GB=2.4 ENG_PRECAP_MIN_FREE_GB=3.0 ENG_C1_PRECAPTURE=1 \
  ENG_MIXED_HEAD_PRECAPTURE=1 ENG_MIXED_HEAD_PRECAPTURE_KEYS=all ENG_MIXED_HEAD_GRAPHS=1000 ENG_MIXED_HEAD_MAX_BM_KEYS=1000 \
  ENG_DECODE_HEAD_PRECAPTURE=1 \
  C1M_PKG=kernels/c1mega/srv8m C1M_SRC=c1mega_s8mc.cu C1M_BUILD=build_s8mc C1IDX_E0K=1 ENG_D13_LONG=1 ND_LONG=1 \
  ENG_HSDT=mhcf,par,dmask,xg,c1d=s8m_nox2,ctxtp,dhead,ctx3 ENG_HSDT_MOD=hsdt_c1m3e PHYS_CXX_ONCTX_LAZY=1

# Head-graph preload OFF (required): with the preload on, a CUDA graph destroyed by torch 2.13 frees the cuBLAS workspace
# that a preloaded head graph still uses (use-after-free; illegal memory access in mixed steps at 64 streams).
# PHYS_KEEP_GRAPHS=1 (required): every torch CUDA graph is kept until exit. ENG_MIXED_HEAD_GUARD_CXX=1: native head guard.
export ENG_DECODE_HEAD_PRECAPTURE_PRELOAD=0 ENG_MIXED_HEAD_PRECAPTURE_PRELOAD=0 PHYS_KEEP_GRAPHS=1 ENG_MIXED_HEAD_GUARD_CXX=1

# Fix A: exact long-context index top-k past 262K context. C1 steps above 262,144 rows run the level-1 C1 kernel module
# (srv8m/c1mega_s8md.cu, built into build_s8md); level 0 (<= 262K) is unchanged. ND_PRECAP_LONG=1048580 precaptures the
# level-1 C1 bucket-4 variant at start-up so no long step meets a late capture.
export C1M_LVL1=1 ENG_C1_PRECAPTURE_LVL1=1 ENG_DECODE_HEAD_PRECAPTURE_LVL1=1 ND_PRECAP_LONG=1048580

# native decode (nd) and the native C/C++ engine loop
export ND_DECODE_COPIES=1 ND_ACCSTAT=1 ND_ACCSTAT_EVERY=64 ENG_MIXED_CXX_CP=3 ND_SPAN_CP=1 \
  PHYS_CXX_MIXED_NATIVE=1 PHYS_CXX_MIXED_EXEC=1 ND_PUB_FAST=0 PHYS_CXX_H1_EPOCH=1 ND_H1_SCAN_SKIP=1 PHYS_CXX_ENS_NATIVE=1 \
  PHYS_CXX_IO_LOG=20 PHYS_CXX_SCHED=1 PHYS_CXX_KV=1 PHYS_CXX_TABLES=1 PHYS_CXX_D13=1 PHYS_CXX_CORE=1 PHYS_CXX_LOOP=1 \
  PHYS_CXX_NATIVE=nd PHYS_CXX_ND_PREBUILT=${PHYS_CXX_ND_PREBUILT:-1} \
  PHYS_CXX_CORE_DIR=$FPR_NATIVE_BUILD PHYS_CXX_SCHED_DIR=$FPR_NATIVE_BUILD PHYS_CXX_BUILD=$FPR_NATIVE_BUILD \
  PHYS_CXX_CORE2B_DIR=$FPR_CORE2B_DIR PHYS_CXX_CORE2B_PROC=$DS41H_REPO/packages/core2b/core2b_proc.r2.py \
  PHYS_CXX_ND_DIR=$FPR_ND_DIR

# cuBLASLt cached plans (FPR_LT_WARM_FILES: optional lists of GEMM shapes to pre-plan at start-up)
export FPR_LT=1 FPR_LT_WARM=${FPR_LT_WARM:-0}

# The C++ API frontend (frontend_cxx) replaces vLLM's Python API server:
#   export VLLM_USE_RUST_FRONTEND=1 VLLM_RUST_FRONTEND_PATH=<path to the built frontend_cxx binary>
